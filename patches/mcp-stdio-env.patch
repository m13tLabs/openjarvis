     ) -> None:
         if response_timeout <= 0:
             raise ValueError("response_timeout must be positive")
         self._command = command
         self._response_timeout = response_timeout
+        self._env = (
+            {**os.environ, **{k: str(v) for k, v in env.items()}} if env else None
