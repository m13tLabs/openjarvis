# Prebuilt base for Dockerfile - JUST the one genuinely long-running step:
# compiling the mandatory openjarvis_rust extension. Rebuilt weekly (+ on
# relevant pushes) by release-base.yml and published as
# ghcr.io/m13tlabs/openjarvis-base / docker.io/m13t/openjarvis-base.
#
# Everything else (frontend build, node runtime, Python env assembly) stays
# in Dockerfile and runs at release time - those are fast enough that hiding
# them behind this weekly cron isn't worth the two-hop Renovate lag (bump
# JARVIS_VERSION here -> wait for a base rebuild -> bump BASE_VERSION in
# Dockerfile) or the risk of a baked-in Rust wheel silently drifting out of
# sync with whatever openjarvis[server] version a release actually installs.
# Dockerfile checks the JARVIS_VERSION marker below against its own pin and
# fails loudly on a mismatch instead of shipping one.
#
# openjarvis/_rust_bridge.py treats the compiled `openjarvis_rust` module as
# MANDATORY - the SQLite/BM25/ColBERT memory backends have no Python fallback
# and raise at request time without it. The PyPI package is pure-Python
# (py3-none-any at every version) and there is no openjarvis-rust on PyPI, but
# the sdist ships the full `rust/` workspace, so build the extension from there
# and carry the wheel forward.

# renovate: datasource=pypi depName=openjarvis versioning=pep440
ARG JARVIS_VERSION=1.0.3

FROM python:3.14-slim AS rust-builder

ARG JARVIS_VERSION

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential curl ca-certificates pkg-config \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir maturin

# The wheel has no `rust/` dir; the sdist does. --no-binary forces the sdist -
# scoped to just openjarvis (not :all:), so hatchling's own build-time deps
# (tomli et al) still install as wheels. :all: cascades the no-binary
# constraint onto them too, which broke here once tomli shipped a release
# whose own sdist build needs tomli already installed to parse its
# pyproject.toml - fine on 3.12 (stdlib tomllib) but circular without it.
RUN mkdir -p /src \
 && pip download --no-deps --no-binary openjarvis "openjarvis==${JARVIS_VERSION}" -d /dl \
 && tar xzf /dl/openjarvis-*.tar.gz -C /src --strip-components=1

# rust/rust-toolchain.toml pins channel 1.88 (the workspace needs let-chains +
# is_multiple_of); rustup installs/selects it automatically on the first build.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup.sh \
 && sh /tmp/rustup.sh -y --default-toolchain none --profile minimal \
 && rm /tmp/rustup.sh
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /src/rust
# Cache the cargo registry + target dir across builds - the weekly cron
# rebuild otherwise recompiles every crate (including rusqlite's bundled
# SQLite) from scratch every time.
RUN --mount=type=cache,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,target=/src/rust/target,sharing=locked \
    maturin build --release \
      --manifest-path crates/openjarvis-python/Cargo.toml \
      --out /wheels \
 && printf '%s' "${JARVIS_VERSION}" > /wheels/JARVIS_VERSION

# ---------------------------------------------------------------------------
# Export - just the wheel and the JARVIS_VERSION marker it was built against.
# Nothing here needs a shell or a filesystem beyond that, so `scratch` keeps
# this image (and the layers callers pull) as small as possible.
# ---------------------------------------------------------------------------
FROM scratch
COPY --from=rust-builder /wheels /wheels
