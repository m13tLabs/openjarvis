# Prebuilt base for Dockerfile.gpu - CUDA equivalent of Dockerfile.base.
# See that file for the shared rationale; only the base images differ here
# (CUDA runtime everywhere the plain base uses python:3.12-slim), for the same
# reason Dockerfile.gpu always has: the compiled openjarvis_rust wheel's
# Python + glibc must match the runtime exactly (Ubuntu 22.04 python3 = 3.10,
# glibc 2.35).
#
# Rebuilt weekly (+ on relevant pushes) by release-base.yml and published as
# ghcr.io/m13tlabs/openjarvis-base:<version>-gpu /
# docker.io/m13t/openjarvis-base:<version>-gpu. Dockerfile.gpu pins the
# resulting tag via BASE_VERSION (Renovate-bumped) and only stamps per-release
# OCI labels on top of it.

# renovate: datasource=pypi depName=openjarvis versioning=pep440
ARG JARVIS_VERSION=1.0.3

# ---------------------------------------------------------------------------
# Rust extension builder
# ---------------------------------------------------------------------------
# renovate: datasource=docker depName=nvidia/cuda
FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04 AS rust-builder

ARG JARVIS_VERSION

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-dev python3-venv \
      build-essential curl ca-certificates pkg-config \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir maturin

RUN mkdir -p /src \
 && pip download --no-deps --no-binary :all: "openjarvis==${JARVIS_VERSION}" -d /dl \
 && tar xzf /dl/openjarvis-*.tar.gz -C /src --strip-components=1

# rust/rust-toolchain.toml pins channel 1.88; rustup installs it on first build.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup.sh \
 && sh /tmp/rustup.sh -y --default-toolchain none --profile minimal \
 && rm /tmp/rustup.sh
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /src/rust
RUN --mount=type=cache,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,target=/src/rust/target,sharing=locked \
    maturin build --release \
      --manifest-path crates/openjarvis-python/Cargo.toml \
      --out /wheels

# ---------------------------------------------------------------------------
# Frontend builder (see Dockerfile.base for the why, incl. the
# crypto.randomUUID polyfill)
# ---------------------------------------------------------------------------
FROM node:22-slim AS frontend-builder

COPY --from=rust-builder /src/frontend /fe
COPY patches/insecure-context-polyfill.js /fe/public/insecure-context-polyfill.js
WORKDIR /fe
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    sed -i 's#</head>#    <script src="/insecure-context-polyfill.js"></script>\n  </head>#' index.html \
 && grep -q 'insecure-context-polyfill.js' index.html \
 && npm ci --no-audit --no-fund \
 && npx vite build --outDir /static --emptyOutDir \
 && test -f /static/insecure-context-polyfill.js \
 && grep -q 'insecure-context-polyfill.js' /static/index.html

# ---------------------------------------------------------------------------
# Node.js runtime + MCP stdio shims (see Dockerfile.base for the why).
# bullseye/glibc 2.31 so the copied `node` runs on the CUDA base's glibc 2.35.
# ---------------------------------------------------------------------------
FROM node:22-bullseye-slim AS node-runtime

# renovate: datasource=npm depName=mcp-remote versioning=npm
ARG MCP_REMOTE_VERSION=0.8.3
# renovate: datasource=npm depName=@baruchiro/paperless-mcp versioning=npm
ARG PAPERLESS_MCP_VERSION=2.0.1
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm install -g --no-audit --no-fund \
      "mcp-remote@${MCP_REMOTE_VERSION}" \
      "@baruchiro/paperless-mcp@${PAPERLESS_MCP_VERSION}"

# ---------------------------------------------------------------------------
# Python builder
# ---------------------------------------------------------------------------
# renovate: datasource=docker depName=nvidia/cuda
FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04 AS builder

ARG JARVIS_VERSION

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-pip python3-venv patch \
 && rm -rf /var/lib/apt/lists/*

COPY --from=rust-builder /wheels /wheels
COPY --from=frontend-builder /static /static

RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    pip install --no-cache-dir uv \
 && uv pip install --system "openjarvis[server]==${JARVIS_VERSION}" \
 && uv pip install --system /wheels/openjarvis_rust-*.whl \
 && cp -r /static "$(python3 -c 'import openjarvis.server, pathlib; print(pathlib.Path(openjarvis.server.__file__).parent / "static")')" \
 && rm -rf /wheels /static

# Teach the MCP stdio transport to pass a per-server `env` to the subprocess
# (upstream ignores it) - see Dockerfile.base / patches/mcp-stdio-env.patch.
COPY patches/mcp-stdio-env.patch /tmp/mcp-stdio-env.patch
RUN OJ_DIR="$(python3 -c 'import openjarvis, pathlib; print(pathlib.Path(openjarvis.__file__).parent)')" \
 && patch -p1 --forward -d "$OJ_DIR" < /tmp/mcp-stdio-env.patch \
 && rm /tmp/mcp-stdio-env.patch \
 && python3 -c "import inspect; from openjarvis.mcp.transport import StdioTransport; assert 'env' in inspect.signature(StdioTransport.__init__).parameters, 'mcp-stdio-env patch did not apply'"

# Widen the server's hardcoded CSP so the SPA's `data:` webfonts load
# (see Dockerfile.base).
RUN CSP_FILE="$(python3 -c 'import openjarvis.server.middleware as m; print(m.__file__)')" \
 && sed -i "s|default-src 'self' 'unsafe-inline' 'unsafe-eval'|default-src 'self' 'unsafe-inline' 'unsafe-eval'; font-src 'self' data:; img-src 'self' data:|g" "$CSP_FILE"

RUN python3 -c "from openjarvis._rust_bridge import RUST_AVAILABLE; assert RUST_AVAILABLE, 'openjarvis_rust missing'" \
 && python3 -c "import openjarvis.server, pathlib; d = pathlib.Path(openjarvis.server.__file__).parent / 'static'; assert (d / 'index.html').is_file(), 'frontend static/ missing'; assert (d / 'insecure-context-polyfill.js').is_file(), 'insecure-context polyfill missing'; assert 'insecure-context-polyfill.js' in (d / 'index.html').read_text(), 'polyfill not referenced by index.html'" \
 && python3 -c "from openjarvis.server.middleware import SECURITY_HEADERS as h; csp = h['Content-Security-Policy']; assert 'font-src' in csp and 'data:' in csp, csp"

# ---------------------------------------------------------------------------
# Base runtime
#
# Same as Dockerfile.gpu's Runtime stage, minus the per-release BUILD_DATE /
# APP_VERSION labels - Dockerfile.gpu stamps those on top of this image.
# ---------------------------------------------------------------------------
# renovate: datasource=docker depName=nvidia/cuda
FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04

# python3: runtime. git: `jarvis skill`. curl: the HEALTHCHECK below.
# libstdc++6: the `node` binary copied below links against it.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 git curl ca-certificates libstdc++6 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local /usr/local

# Node.js + the pre-installed MCP stdio shims (see the node-runtime stage).
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && ln -s ../lib/node_modules/mcp-remote/dist/proxy.js /usr/local/bin/mcp-remote \
 && ln -s "../lib/node_modules/@baruchiro/paperless-mcp/build/index.js" /usr/local/bin/paperless-mcp \
 && node --version && npm --version \
 && node -e "require('/usr/local/lib/node_modules/mcp-remote/package.json'); require('/usr/local/lib/node_modules/@baruchiro/paperless-mcp/package.json')" \
 && test -e /usr/local/bin/mcp-remote && test -e /usr/local/bin/paperless-mcp
ENV NPM_CONFIG_CACHE=/tmp/.npm NPM_CONFIG_UPDATE_NOTIFIER=false

WORKDIR /app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["curl", "-fsS", "http://localhost:8000/health"]

ENTRYPOINT ["jarvis"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8000"]
