# Prebuilt base for Dockerfile.gpu - CUDA equivalent of Dockerfile.base (same
# scope: just the compiled openjarvis_rust wheel, see that file for why). The
# CUDA base here isn't optional the way it is for the plain image: the
# compiled wheel's Python + glibc must match the runtime exactly (Ubuntu
# 22.04 python3 = 3.10, glibc 2.35), so this can't share a build with the
# python:3.12-slim base.
#
# Published as ghcr.io/m13tlabs/openjarvis-base:<version>-gpu /
# docker.io/m13t/openjarvis-base:<version>-gpu.

# renovate: datasource=pypi depName=openjarvis versioning=pep440
ARG JARVIS_VERSION=1.0.3

# renovate: datasource=docker depName=nvidia/cuda
FROM nvidia/cuda:12.9.2-runtime-ubuntu22.04 AS rust-builder

ARG JARVIS_VERSION

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-dev python3-venv \
      build-essential curl ca-certificates pkg-config \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir maturin

# --no-binary scoped to just openjarvis, not :all: - see Dockerfile.base for
# why (:all: cascades onto hatchling's own build deps and breaks tomli's
# sdist build on this stage's Python 3.10, which has no stdlib tomllib).
RUN mkdir -p /src \
 && pip download --no-deps --no-binary openjarvis "openjarvis==${JARVIS_VERSION}" -d /dl \
 && tar xzf /dl/openjarvis-*.tar.gz -C /src --strip-components=1

# rust/rust-toolchain.toml pins channel 1.88; rustup installs it on first build.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup.sh \
 && sh /tmp/rustup.sh -y --default-toolchain none --profile minimal \
 && rm /tmp/rustup.sh
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /src/rust
RUN --mount=type=cache,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,target=/src/rust/target,sharing=locked \
    maturin build --release \
      --manifest-path crates/openjarvis-python/Cargo.toml \
      --out /wheels \
 && printf '%s' "${JARVIS_VERSION}" > /wheels/JARVIS_VERSION

# ---------------------------------------------------------------------------
# Export - just the wheel and the JARVIS_VERSION marker it was built against.
# ---------------------------------------------------------------------------
FROM scratch
COPY --from=rust-builder /wheels /wheels
